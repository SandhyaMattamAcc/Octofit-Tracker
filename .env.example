# AMS Dashboard Environment Variables
# Copy to .env and fill in your values

# Required for live CrewAI agent execution
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Alternative LLM providers
# ANTHROPIC_API_KEY=your_anthropic_key
# GROQ_API_KEY=your_groq_key

# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
RELOAD=true

# Agent configuration
AGENT_MAX_ITER=8
AGENT_VERBOSE=true
CREW_MEMORY=true

# ServiceNow integration (production)
# SERVICENOW_INSTANCE=your-instance.service-now.com
# SERVICENOW_USER=api_user
# SERVICENOW_PASSWORD=your_password

# Dynatrace integration (production)
# DYNATRACE_URL=https://your-tenant.live.dynatrace.com
# DYNATRACE_API_TOKEN=your_dt_api_token
